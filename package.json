    "@codex-bank-teller/verification": "workspace:*",
    "@codex-bank-teller/workflow-registry": "workspace:*",
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.0",
    "eslint": "^9.20.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
